=== PAM access policy ===
- : curator1 curator2 : ALL
=== PAM services ===
/etc/pam.d/login:5:account required pam_access.so accessfile=/etc/security/mephi-local-login.conf
/etc/pam.d/gdm-password:9:account required pam_access.so accessfile=/etc/security/mephi-local-login.conf
/etc/pam.d/gdm-fingerprint:5:account required pam_access.so accessfile=/etc/security/mephi-local-login.conf
/etc/pam.d/gdm-smartcard:5:account required pam_access.so accessfile=/etc/security/mephi-local-login.conf
/etc/pam.d/gdm-autologin:6:account required pam_access.so accessfile=/etc/security/mephi-local-login.conf
=== Minimum password length ===
minlen = 12
dcredit = 0
ucredit = 0
lcredit = 0
ocredit = 0
enforce_for_root
